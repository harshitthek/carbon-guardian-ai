# ==========================================
# Carbon Guardian - Environment Variables
# ==========================================

# ------------------------------------------
# Backend Configuration (.env in /backend)
# ------------------------------------------

# JWT Secret Key for securely signing access tokens (replace with a secure random string in production)
JWT_SECRET_KEY=your_super_secret_jwt_key_here

# Seed Admin Password used by scripts/seed.py to initialize the database
SEED_ADMIN_PASSWORD=your_secure_password_here

# (Optional) Database URL if not using the default local SQLite db (carbon_guardian.db)
# DATABASE_URL=postgresql://user:password@localhost/dbname

# ------------------------------------------
# Frontend Configuration (.env in /frontend)
# ------------------------------------------

# Base URL for the backend API
VITE_API_BASE=http://127.0.0.1:8000

# Set to 'true' to use mock data instead of live backend endpoints (useful for UI testing)
VITE_USE_MOCKS=false
